# Copy to `.env.local` (git-ignored) and fill in real values.
# `npx supabase start` prints the local URL and keys to paste here.

# Local Supabase defaults to http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose: the anon key is limited by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site, used to build the board link printed as a QR code.
# http://localhost:3000 locally; the production domain when deployed.
SITE_URL=

# Server-side only. Signs the visitor device cookie and derives username tags.
# Any random string of 32+ characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it resets every device's daily post limit and name tags.
DEVICE_COOKIE_SECRET=
