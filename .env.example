# Copy to `.env.local` (git-ignored) and fill in real values.
# `npx supabase start` prints the local URL and keys to paste here.

# Local Supabase defaults to http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose: the anon key is limited by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site, used to build the board link printed as a QR code.
# http://localhost:3000 locally; the production domain when deployed.
SITE_URL=

# Server-side only. Checks names, captions and drawings before posts go live.
# Restrict the key to Moderations (/v1/moderations); that endpoint is free.
# Posting is refused while this is missing or invalid, never published unchecked.
OPENAI_API_KEY=

# Optional. Extra blocked words or phrases, comma-separated, matched case- and
# accent-insensitively. Kept out of the repo, which is public. Links, email
# addresses and phone numbers are always blocked.
MODERATION_BLOCKLIST=

# Server-side only. Signs the visitor device cookie and derives username tags.
# Any random string of 32+ characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it resets every device's daily post limit and name tags.
DEVICE_COOKIE_SECRET=

# Cloudflare Turnstile, proving a submission came from a browser. Create a
# widget at https://dash.cloudflare.com → Turnstile (Managed mode). Posting and
# owner sign-in are refused while these are missing or invalid.
# Cloudflare's always-passing test pair is fine for local work:
# 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# Safe to expose: the site key is rendered in the page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side only.
TURNSTILE_SECRET_KEY=

# Local Supabase only: the Google OAuth client customers sign in with. The
# hosted project keeps its own copy in the Supabase dashboard, so these two are
# never read by the app itself — only by `npx supabase start`, which also reads
# them from `.env` in the project root.
# Create the client at https://console.cloud.google.com → Google Auth Platform →
# Clients → Web application, with these redirect URIs:
#   http://127.0.0.1:54321/auth/v1/callback
#   https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server-side only. Bearer token Vercel Cron sends to the daily cleanup
# endpoint; set it in Vercel (Secret) and the cron job picks it up. While it's
# unset the endpoint refuses to run, which is what you want everywhere but
# production. Any long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
